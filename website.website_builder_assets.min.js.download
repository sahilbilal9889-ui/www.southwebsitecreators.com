                <span class="o_handle_indicator"/>
            </div>


             <div class="o_handle o_grid_handle o_side o_side_y n d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_side o_side_x e d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_side o_side_x w d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_side o_side_y s d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_corner_handle ne d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_corner_handle nw d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_corner_handle se d-none">
                <span class="o_handle_indicator"/>
            </div>
             <div class="o_handle o_grid_handle o_corner_handle sw d-none">
                <span class="o_handle_indicator"/>
            </div>
        </div>
    </div>
</t>

`);
registerTemplate("html_builder.BasicMany2Many", `/html_builder/static/src/core/building_blocks/basic_many2many.xml`, `<t t-name="html_builder.BasicMany2Many" xml:space="preserve">
    <div class="d-flex flex-column">
        <table class="o-hb-m2m-table">
            <tr t-foreach="this.props.selection" t-as="entry" t-key="entry.id">
                <td>
                    <input type="text" class="o-hb-input-base" disabled="" t-att-data-name="entry.display_name" t-att-value="entry.display_name"/>
                </td>
                <td>
                    <button class="mt-0 border-0 p-0 bg-transparent text-danger fa fa-fw fa-minus" t-on-click="() =&gt; this.unselect(entry.id)"/>
                </td>
            </tr>
        </table>
        <SelectMany2X model="this.props.model" fields="this.props.fields" limit="this.props.limit" domain="this.props.domain" selected="this.props.selection" select="this.select.bind(this)" create="this.props.create"/>
    </div>
</t>

`);
registerTemplate("html_builder.BuilderButtonInternal", `/html_builder/static/src/core/building_blocks/builder_button.xml`, `<t t-name="html_builder.BuilderButtonInternal" xml:space="preserve">
    <BuilderComponent>
        <button type="button" class="o-hb-btn btn" t-att-style="this.props.style" t-att-data-action-id="this.info.actionId" t-att-data-action-param="this.info.actionParam" t-att-data-action-value="this.info.actionValue" t-att-data-class-action="this.info.classAction" t-att-data-style-action="this.info.styleAction" t-att-data-style-action-value="this.info.styleActionValue" t-att-data-attribute-action="this.info.attributeAction" t-att-data-attribute-action-value="this.info.attributeActionValue" t-att-data-data-attribute-action="this.info.dataAttributeAction" t-att-data-data-attribute-action-value="this.info.dataAttributeActionValue" t-att-class="this.className" t-att-title="(this.state.isActive and this.props.titleActive) or this.props.title" t-att-aria-label="this.props.title" t-on-click="() =&gt; this.onClick()" t-on-pointerenter="() =&gt; this.onPointerEnter(this.props.id)" t-on-pointerleave="() =&gt; this.onPointerLeave(this.props.id)">
            <Image t-if="this.props.iconImg" src="this.props.iconImg" attrs="{ alt: this.props.iconImgAlt }" style="this.props.iconImgStyle"/>
            <i t-if="this.props.icon" t-att-class="this.iconClassName" role="img"/>
            <t t-if="this.props.label" t-out="this.props.label"/>
            <t t-call-slot="default"/>
        </button>
    </BuilderComponent>
</t>

`);
registerTemplate("html_builder.BuilderButtonGroup", `/html_builder/static/src/core/building_blocks/builder_button_group.xml`, `<t t-name="html_builder.BuilderButtonGroup" xml:space="preserve">
    <BuilderComponent>
        <div class="o-hb-button-group btn-group" t-custom-ref="root">
            <t t-call-slot="default"/>
        </div>
    </BuilderComponent>
</t>

`);
registerTemplate("html_builder.BuilderCheckbox", `/html_builder/static/src/core/building_blocks/builder_checkbox.xml`, `<t t-name="html_builder.BuilderCheckbox" xml:space="preserve">
    <BuilderComponent>
        <div t-att-data-action-id="this.info.actionId" t-att-data-action-param="this.info.actionParam" t-att-data-action-value="this.info.actionValue" t-att-data-class-action="this.info.classAction" t-att-data-style-action="this.info.styleAction" t-att-data-style-action-value="this.info.styleActionValue" t-att-data-attribute-action="this.info.attributeAction" t-att-data-attribute-action-value="this.info.attributeActionValue" t-on-pointerenter="() =&gt; this.onPointerEnter(this.props.id)" t-on-pointerleave="() =&gt; this.onPointerLeave(this.props.id)" data-prevent-closing-overlay="true">
            <CheckBox className="this.getClassName()" onChange="this.onChange" value="this.state.isActive"/>
        </div>
    </BuilderComponent>
</t>

`);
registerTemplate("html_builder.BuilderColorPicker", `/html_builder/static/src/core/building_blocks/builder_colorpicker.xml`, `<t t-name="html_builder.BuilderColorPicker" xml:space="preserve">
    <BuilderComponent>
        <ColorPickerButton title="this.props.title" style="this.getSelectedColorStyle()" tooltip="this.props.tooltip or this.props.title" colorPickerConfig="this.colorPickerConfig"/>
    </BuilderComponent>
</t>

`);
registerTemplate("html_builder.ColorPickerButton", `/html_builder/static/src/core/building_blocks/builder_colorpicker.xml`, `<t t-name="html_builder.ColorPickerButton" xml:space="preserve">
    <button t-att-title="this.props.title" class="o_we_color_preview" t-custom-ref="colorButton" t-att-style="this.props.style" t-att-data-tooltip="this.props.tooltip"/>
</t>

`);
registerTemplate("html_builder.BuilderDateTimePicker", `/html_builder/static/src/core/building_blocks/builder_datetimepicker.xml`, `<t t-name="html_builder.BuilderDateTimePicker" xml:space="preserve">
    <BuilderComponent>
        <div t-custom-ref="root" class="w-100">
            <BuilderTextInputBase t-props="this.textInputBaseProps" commit="this.commit" preview="this.preview" onFocus.bind="this.onFocus" value="this.displayValue"/>
        </div>
    </BuilderComponent>
</t>

