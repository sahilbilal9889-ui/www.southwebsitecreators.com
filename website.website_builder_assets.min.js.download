registerTemplate("website.ProcessStepsOption", `/website/static/src/builder/plugins/options/process_steps_option.xml`, `<t t-name="website.ProcessStepsOption" xml:space="preserve">
    <BuilderRow label.translate="Connector">
        <BuilderSelect>
            <t t-foreach="this.connectorOptionParams" t-as="connectorOptionParam" t-key="connectorOptionParam_index">
                <BuilderSelectItem action="'changeConnector'" id="this.getConnectorId(connectorOptionParam.key)" actionParam="connectorOptionParam.key"><t t-out="connectorOptionParam.param"/></BuilderSelectItem>
            </t>
        </BuilderSelect>
        <BuilderColorPicker styleAction="'stroke'" t-if="!this.isActiveItem('no_connector_opt')" applyTo="'.s_process_step_connector path'" action="'changeArrowColor'" enabledTabs="['solid', 'custom']"/>
    </BuilderRow>
</t>

`);
registerTemplateExtension("website.BuilderOptions", `/website/static/src/builder/plugins/options/process_steps_option.xml`, `<t t-inherit="website.BuilderOptions" t-inherit-mode="extension" xml:space="preserve">
