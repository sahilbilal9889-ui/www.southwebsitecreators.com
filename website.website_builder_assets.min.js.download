</t>

`);
registerTemplate("website.FaqHorizontalOption", `/website/static/src/builder/plugins/options/faq_horizontal_option.xml`, `<t t-name="website.FaqHorizontalOption" xml:space="preserve">
    <BuilderRow label.translate="Topics">
        <BuilderButton type="'success'" action="'addItem'" actionParam="'.s_faq_horizontal_entry:last-of-type'" preview="false" applyTo="':scope &gt; :has(.s_faq_horizontal_entry)'">
            Add Section
        </BuilderButton>
    </BuilderRow>
</t>

`);
registerTemplateExtension("website.BuilderOptions", `/website/static/src/builder/plugins/options/faq_horizontal_option.xml`, `<t t-inherit="website.BuilderOptions" t-inherit-mode="extension" xml:space="preserve">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
