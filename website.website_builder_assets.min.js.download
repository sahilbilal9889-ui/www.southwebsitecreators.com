registerTemplate("website.TimelineListOption", `/website/static/src/builder/plugins/options/timeline_list_option.xml`, `<t t-name="website.TimelineListOption" xml:space="preserve">
    <BuilderRow label.translate="Milestones" applyTo="':scope &gt; :has(.s_timeline_list_row)'">
        <BuilderButton type="'success'" action="'addItem'" actionParam="'.s_timeline_list_row:last-child'" preview="false">Add Milestone</BuilderButton>
    </BuilderRow>

    <BuilderRow label.translate="Alignment">
        <BuilderButtonGroup applyTo="'.s_timeline_list_wrapper'">
            <BuilderButton ltrRtlMapping="'left-right'" icon="'fa-align-left'" title.translate="Align Left" classAction="'justify-content-start'"/>
            <BuilderButton icon="'fa-align-center'" title.translate="Align Center" classAction="'justify-content-center'"/>
            <BuilderButton ltrRtlMapping="'left-right'" icon="'fa-align-right'" title.translate="Align Right" classAction="'justify-content-end'"/>
        </BuilderButtonGroup>
    </BuilderRow>
</t>

`);
registerTemplateExtension("website.BuilderOptions", `/website/static/src/builder/plugins/options/timeline_list_option.xml`, `<t t-inherit="website.BuilderOptions" t-inherit-mode="extension" xml:space="preserve">
