        </BuilderContext>
    </t>

    `);
registerTemplateExtension("website.BuilderOptions", `/website/static/src/builder/plugins/options/website_info_option.xml`, `<t t-inherit="website.BuilderOptions" t-inherit-mode="extension" xml:space="preserve">
        <xpath expr="//t[@id='page_options_hook']" position="after">
            <info_page_option template="website.InfoPageOption" selector="main:has(.o_website_info)" title="Info Page" editableOnly="false" groups="[&quot;website.group_website_designer&quot;]"/>
